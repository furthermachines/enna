    },
    {
      "from": "proposed",
      "event": "cancel",
      "to": "cancelled"
    },
    {
      "from": "awaiting_approval",
      "event": "approve",
      "to": "authorized"
    },
    {
      "from": "awaiting_approval",
      "event": "reject",
      "to": "rejected"
    },
    {
      "from": "awaiting_approval",
      "event": "revise",
      "to": "awaiting_approval"
    },
    {
      "from": "awaiting_approval",
      "event": "cancel",
      "to": "cancelled"
    },
    {
      "from": "authorized",
      "event": "start",
      "to": "executing"
    },
    {
      "from": "authorized",
      "event": "block",
      "to": "blocked"
    },
    {
      "from": "authorized",
      "event": "revise",
      "to": "awaiting_approval"
    },
    {
      "from": "authorized",
      "event": "cancel",
      "to": "cancelled"
    },
    {
      "from": "executing",
      "event": "complete_execution",
      "to": "execution_complete"
    },
    {
      "from": "executing",
      "event": "block",
      "to": "blocked"
    },
    {
      "from": "execution_complete",
      "event": "start_evaluation",
      "to": "evaluating"
    },
    {
      "from": "execution_complete",
      "event": "revise",
      "to": "awaiting_approval"
    },
    {
      "from": "execution_complete",
      "event": "cancel",
      "to": "cancelled"
    },
    {
      "from": "evaluating",
      "event": "complete_evaluation",
      "to": "awaiting_acceptance"
    },
    {
      "from": "evaluating",
      "event": "revise",
      "to": "awaiting_approval"
    },
    {
      "from": "evaluating",
      "event": "cancel",
      "to": "cancelled"
    },
    {
      "from": "awaiting_acceptance",
      "event": "accept",
      "to": "accepted"
    },
    {
      "from": "awaiting_acceptance",
      "event": "reject",
      "to": "rejected"
    },
    {
      "from": "awaiting_acceptance",
      "event": "revise",
      "to": "awaiting_approval"
    },
    {
      "from": "awaiting_acceptance",
