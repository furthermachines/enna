{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://businessagentprotocol.org/spec/v0.1/schemas/discovery.schema.json",
  "title": "Enna discovery document",
  "description": "Served at /.well-known/enna.json, a proposed draft convention not registered with IANA. Publication follows the Personal Agent Protocol 0.1 rules. Nothing sensitive belongs here.",
  "type": "object",
  "required": ["protocol_version", "organization"],
  "properties": {
    "protocol_version": { "$ref": "common.schema.json#/$defs/protocol_version" },
    "description": {
      "description": "What this document covers, in plain text.",
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "organization": {
      "type": "object",
      "required": ["name", "domain"],
      "properties": {
        "name": { "$ref": "common.schema.json#/$defs/text" },
        "domain": { "$ref": "common.schema.json#/$defs/domain" },
        "legal_name": { "$ref": "common.schema.json#/$defs/text" },
        "jurisdiction": { "type": "string", "pattern": "^[A-Z]{2}(-[A-Z0-9]{1,3})?$" },
        "registration_ids": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["scheme", "value"],
            "properties": {
              "scheme": { "$ref": "common.schema.json#/$defs/token" },
              "value": { "$ref": "common.schema.json#/$defs/text" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "auth": {
      "type": "object",
      "required": ["issuer"],
      "properties": { "issuer": { "$ref": "common.schema.json#/$defs/https_url" } },
      "additionalProperties": false
    },
    "agents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["client_id", "role", "accepts", "transports"],
        "properties": {
          "client_id": { "$ref": "common.schema.json#/$defs/https_url" },
          "role": { "$ref": "common.schema.json#/$defs/token" },
          "accepts": {
            "description": "Profiles or action namespaces this agent takes work for.",
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "common.schema.json#/$defs/text" }
          },
          "transports": {
            "type": "object",
            "minProperties": 1,
            "properties": {
              "a2a": {
                "type": "object",
                "required": ["agent_card"],
                "properties": { "agent_card": { "$ref": "common.schema.json#/$defs/https_url" } },
                "additionalProperties": false
              },
              "mcp": {
                "type": "object",
                "required": ["url"],
                "properties": { "url": { "$ref": "common.schema.json#/$defs/https_url" } },
                "additionalProperties": false
              },
              "pap": {
                "type": "object",
                "required": ["endpoint"],
                "properties": { "endpoint": { "$ref": "common.schema.json#/$defs/https_url" } },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "conformance": {
      "description": "Self-declared. Enna has no certification.",
      "type": "object",
      "required": ["classes", "level", "self_declared", "statement_url"],
      "properties": {
        "classes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["producer", "consumer", "enforcement_point", "evaluator"] }
        },
        "level": { "enum": ["essential", "controlled", "assured"] },
        "profiles": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/profile" }
        },
        "self_declared": { "const": true },
        "statement_url": { "$ref": "common.schema.json#/$defs/https_url" }
      },
      "additionalProperties": false
    },
    "approvals": {
      "type": "object",
      "required": ["modes"],
      "properties": {
        "modes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["interactive", "standing", "pap_confirmation"] }
        },
        "verifiable": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "delegation": {
      "type": "object",
      "required": ["max_depth"],
      "properties": {
        "max_depth": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
      },
      "additionalProperties": false
    },
    "receipts": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "jwks_uri": { "$ref": "common.schema.json#/$defs/https_url" },
        "retention_seconds": { "$ref": "common.schema.json#/$defs/duration_seconds" }
      },
      "additionalProperties": false
    },
    "contacts": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "security": { "$ref": "#/$defs/contact" },
        "privacy": { "$ref": "#/$defs/contact" },
        "agent_operations": { "$ref": "#/$defs/contact" }
      },
      "additionalProperties": false
    },
    "policies": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "terms": { "$ref": "common.schema.json#/$defs/https_url" },
        "privacy": { "$ref": "common.schema.json#/$defs/https_url" },
        "data_processing": { "$ref": "common.schema.json#/$defs/https_url" }
      },
      "additionalProperties": false
    },
    "pap": {
      "type": "object",
      "required": ["poppy_json"],
      "properties": { "poppy_json": { "$ref": "common.schema.json#/$defs/https_url" } },
      "additionalProperties": false
    },
    "extensions": { "$ref": "common.schema.json#/$defs/extensions" }
  },
  "if": { "required": ["agents"] },
  "then": { "required": ["auth"] },
  "additionalProperties": false,
  "$defs": {
    "contact": {
      "type": "string",
      "maxLength": 2048,
      "pattern": "^(https://|mailto:)[!-~]+$",
      "format": "uri"
    }
  }
}
